node_modules/
dist/
build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Packaging & Distribution
*.egg-info/
*.egg
eggs/
parts/
var/
sdist/
develop-eggs/

