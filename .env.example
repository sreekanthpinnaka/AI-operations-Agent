# ==============================================================================
# AI Operations Agent - Environment Configuration
# ==============================================================================

# Application & Gateway
APP_NAME=AI Operations Agent
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api

# Database Connection
# Option 1: Local SQLite (default - zero setup, auto-seeded on startup)
DATABASE_URL=sqlite:///./gemini_ops.db

# Option 2: Google Cloud SQL / Remote MySQL
# DATABASE_URL=mysql+pymysql://db_user:db_password@34.xxx.xxx.xxx:3306/ai_ops

# Model Provider Settings (OpenAI / Gemini)
# Leave blank to use deterministic local agent fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT_SECONDS=30.0

# Optional Google Gemini Fallback Key
# GEMINI_API_KEY=your_gemini_api_key_here

# Operational Governance Limits
MAX_PLAN_STEPS=12
MAX_TOOL_RETRIES=2
MAX_PENDING_ACTIONS=50
DEFAULT_OPERATOR_EMAIL=admin@opsagent.local

# 🔭 LangGraph Observability & Visual Tracing
# Standalone Server: https://github.com/sreekanthpinnaka/langgraph_observability_tool
OBSERVE_SERVER_URL=http://localhost:8765
OBSERVE_PROJECT=ai-operations-agent
OBSERVE_ENVIRONMENT=development
